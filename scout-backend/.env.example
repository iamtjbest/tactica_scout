# Copy to .env and fill in real values. .env is gitignored — keep it that way.
# Never commit a real key to this file.

# Sports data provider
BSD_API_KEY=your_bsd_api_key_here

# Supabase. Service role key bypasses Row Level Security, so it is admin
# access to the database. Backend only, never ship it to a frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Firebase Admin. Paste the entire service-account JSON on one line.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Local cache dir. Ephemeral on Render, which is fine, it just rebuilds.
CACHE_DIR=/tmp/pulse_cache
