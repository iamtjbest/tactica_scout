# Copy to .env and fill in real values. .env is gitignored — keep it that way.
# Never commit a real key to this file.

# Sports data provider
BSD_API_KEY=your_bsd_api_key_here

# Supabase — Settings > API in the dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key: bypasses Row Level Security, so it is full admin
# access to the database. Backend only. Never ship it to a frontend.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anon key: the public key your web and mobile apps already use. The
# backend needs it only as the `apikey` header when validating a token
# against the Auth server. Safe to expose.
SUPABASE_ANON_KEY=your_anon_key_here

# Local cache dir. Ephemeral on Render, which is fine, it just rebuilds.
CACHE_DIR=/tmp/pulse_cache

# Main Tactica backend — source of ATK/DEF ratings and win probability
TACTICA_API_URL=https://tactica-backend-hdbd.onrender.com
