# Copy to .env.local and fill in. .env.local is gitignored.

# Scout backend (same service the editor and Scout both use)
NEXT_PUBLIC_API_URL=https://tactica-scout-api.onrender.com

# Supabase. Same project as Scout: one account works in both apps.
# The publishable key is safe in a browser bundle.
# Never put the secret key in here.
# Get this from Supabase > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://hpgaaqkytifdqajpdtlu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY_HERE
